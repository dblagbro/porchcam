[Desktop Entry]
Type=Application
Name=Porch Camera Overlay
Comment=Start the porch camera overlay when the desktop session begins
Exec=/usr/local/bin/porchcam-overlay
Icon=camera-web
Terminal=false
X-GNOME-Autostart-enabled=true
# Give the capture service a moment after login before connecting.
X-GNOME-Autostart-Delay=8
StartupNotify=false
