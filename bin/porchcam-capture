#!/bin/bash
# porchcam-capture — open the C920 once and publish it to the local RTSP server.
#
# The camera is opened exactly once, here. Every consumer (Blue Iris, the desktop
# overlay, anything else) reads from MediaMTX instead of touching /dev/video*,
# which is what lets the overlay come and go without disturbing the recording.
set -uo pipefail

CONF=/etc/porchcam/capture.env
# shellcheck source=/dev/null
[[ -r $CONF ]] && . "$CONF"

DEVICE=${DEVICE:-/dev/v4l/by-id/usb-046d_HD_Pro_Webcam_C920_XXXXXXXX-video-index0}
WIDTH=${WIDTH:-1920}
HEIGHT=${HEIGHT:-1080}
FPS=${FPS:-30}
INPUT_FORMAT=${INPUT_FORMAT:-h264}
RTSP_URL=${RTSP_URL:-rtsp://127.0.0.1:8554/porch}
API=${API:-http://127.0.0.1:9997/v3/config/global/get}
READY_TIMEOUT=${READY_TIMEOUT:-30}
PKT_SIZE=${PKT_SIZE:-1200}
DYNAMIC_FRAMERATE=${DYNAMIC_FRAMERATE:-0}

log() { printf '%s porchcam-capture: %s\n' "$(date -Is)" "$*"; }

# --- Readiness: wait for the camera node ------------------------------------
deadline=$((SECONDS + READY_TIMEOUT))
until [[ -e $DEVICE ]]; do
    (( SECONDS >= deadline )) && { log "FATAL: camera $DEVICE never appeared"; exit 1; }
    sleep 0.5
done
log "camera $DEVICE -> $(readlink -f "$DEVICE")"

# Confirm identity, so a USB re-enumeration can never silently stream the wrong camera.
CARD=$(v4l2-ctl -d "$DEVICE" --info 2>/dev/null | sed -n 's/^\s*Card type\s*:\s*//p')
log "card type: ${CARD:-unknown}"
if [[ -n ${EXPECT_CARD:-} && $CARD != *"$EXPECT_CARD"* ]]; then
    log "FATAL: expected card '$EXPECT_CARD' but found '$CARD' — refusing to stream"
    exit 1
fi

# --- Camera controls ---------------------------------------------------------
# exposure_dynamic_framerate=1 lets the C920 lengthen exposure in low light, which
# brightens the picture but drops the frame rate (as low as ~4fps in darkness).
# Default 0 keeps the frame rate steady, which Blue Iris motion detection prefers.
if v4l2-ctl -d "$DEVICE" --set-ctrl=exposure_dynamic_framerate="$DYNAMIC_FRAMERATE" 2>/dev/null; then
    log "exposure_dynamic_framerate=$DYNAMIC_FRAMERATE"
else
    log "WARN: could not set exposure_dynamic_framerate (continuing)"
fi

# --- Readiness: wait for the RTSP server ------------------------------------
deadline=$((SECONDS + READY_TIMEOUT))
until curl -sf --max-time 2 "$API" >/dev/null 2>&1; do
    (( SECONDS >= deadline )) && { log "FATAL: RTSP server not ready after ${READY_TIMEOUT}s"; exit 1; }
    sleep 0.5
done
log "RTSP server ready; publishing ${WIDTH}x${HEIGHT}@${FPS} ($INPUT_FORMAT, stream copy)"

# --- Publish -----------------------------------------------------------------
# -c:v copy: the C920 encodes H.264 in hardware, so this box does no encoding.
# -pkt_size: keep RTP payloads under the server's 1440-byte limit so it never
#            has to re-fragment them.
#: exit on a muxer/encoder error instead of lingering with a dead
# output. Without it a restart of the RTSP server leaves this process alive
# but no longer publishing, holding the camera open, and systemd's
# Restart=always never fires because nothing ever exited.

# --- Publish, with a readiness watchdog --------------------------------------
# ffmpeg does NOT reliably exit when its RTSP output dies: if the server
# restarts, it can sit there holding the camera with a broken output forever,
# and because it never exits, systemd's Restart=always never fires.  (-xerror is
# not the answer: it ignores that case and instead aborts on harmless
# startup warnings like "Non-monotonic DTS".)
#
# So supervise it from outside: poll the server for this path's readiness and
# exit non-zero if it stays down, which lets systemd restart us cleanly.
PATH_NAME=${RTSP_URL##*/}
PATHS_API=${PATHS_API:-http://127.0.0.1:9997/v3/paths/list}
WATCHDOG_TIMEOUT=${WATCHDOG_TIMEOUT:-25}
WATCHDOG_GRACE=${WATCHDOG_GRACE:-20}

path_ready() {
    curl -sf --max-time 3 "$PATHS_API" 2>/dev/null | PATH_NAME="$PATH_NAME" python3 -c "
import json, os, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(1)
want = os.environ['PATH_NAME']
for p in d.get('items', []):
    if p.get('name') == want:
        sys.exit(0 if p.get('ready') else 1)
sys.exit(1)
"
}

FFPID=""
cleanup() { [[ -n $FFPID ]] && kill -TERM "$FFPID" 2>/dev/null; }
trap cleanup TERM INT EXIT

ffmpeg -nostdin -hide_banner -loglevel warning \
    -use_wallclock_as_timestamps 1 \
    -f v4l2 -input_format "$INPUT_FORMAT" \
    -video_size "${WIDTH}x${HEIGHT}" -framerate "$FPS" \
    -i "$DEVICE" \
    -an -c:v copy \
    -pkt_size "$PKT_SIZE" \
    -f rtsp -rtsp_transport tcp "$RTSP_URL" &
FFPID=$!
log "ffmpeg pid $FFPID; watchdog armed (path '$PATH_NAME', ${WATCHDOG_TIMEOUT}s tolerance)"

sleep "$WATCHDOG_GRACE"   # let the first frames make it through before judging

down=0
while kill -0 "$FFPID" 2>/dev/null; do
    if path_ready; then
        down=0
    else
        down=$((down + 5))
        if (( down >= WATCHDOG_TIMEOUT )); then
            log "watchdog: path '$PATH_NAME' down ${down}s — exiting so systemd restarts us"
            kill -TERM "$FFPID" 2>/dev/null; sleep 2; kill -KILL "$FFPID" 2>/dev/null
            exit 1
        fi
    fi
    sleep 5
done

wait "$FFPID"; rc=$?
log "ffmpeg exited rc=$rc"
exit "$rc"
