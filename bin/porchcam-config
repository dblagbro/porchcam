#!/usr/bin/env python3
"""porchcam-config — manage porchcam camera configuration.

Phase 0 of the packaging roadmap (see docs/ROADMAP.md): a single declarative
config, `/etc/porchcam/porchcam.yaml`, becomes the source of truth. `render`
writes the per-camera `*.env` files the capture services already read, so the
YAML and the running services never drift. `import` builds a YAML from existing
`*.env` files (the upgrade path for current installs).

This tool never touches a running service — after `render` you apply changes the
same way as always: `sudo systemctl restart porchcam-capture deskcam-capture`.
It is also the config layer the web UI and the AI-assisted setup will drive.

    porchcam-config import [--env-dir DIR] [--out FILE]
    porchcam-config render [--config FILE] [--out-dir DIR] [--dry-run]
    porchcam-config validate [--config FILE]
    porchcam-config list [--config FILE]
"""

import argparse
import re
import sys
from pathlib import Path

import yaml

SCHEMA_VERSION = 1
DEFAULT_CONFIG = Path("/etc/porchcam/porchcam.yaml")
DEFAULT_ENV_DIR = Path("/etc/porchcam")
DEFAULT_RTSP_BASE = "rtsp://127.0.0.1:8554"

# Known env-file -> systemd service, so an imported config keeps the mapping.
SERVICE_BY_ENV = {
    "capture.env": "porchcam-capture",
    "deskcam.env": "deskcam-capture",
}

# camera field -> env key, for the flat scalar fields. Order here is the order
# the keys are written to the .env file.
FIELD_TO_ENV = [
    ("device", "DEVICE"),
    ("expect_card", "EXPECT_CARD"),
    ("width", "WIDTH"),
    ("height", "HEIGHT"),
    ("fps", "FPS"),
    ("input_format", "INPUT_FORMAT"),
    ("rtsp_url", "RTSP_URL"),         # assembled from rtsp_base + rtsp_path
    ("pkt_size", "PKT_SIZE"),
    ("dynamic_framerate", "DYNAMIC_FRAMERATE"),
    ("bitrate", "BITRATE"),
    ("vaapi_device", "VAAPI_DEVICE"),
    ("img_ctrls", "IMG_CTRLS"),
    ("usb_id", "USB_ID"),
]
ENV_TO_FIELD = {env: field for field, env in FIELD_TO_ENV}

# env keys that are integers / booleans so round-trips are type-stable
INT_ENVS = {"WIDTH", "HEIGHT", "FPS", "PKT_SIZE", "CONF_WIDTH", "CONF_HEIGHT"}
BOOL_ENVS = {"DYNAMIC_FRAMERATE"}


# --- env parsing / writing ---------------------------------------------------

def parse_env(text):
    """Parse a bash-style KEY=VALUE env file into an ordered dict.

    Handles quoted values and trailing ` # comment` (space-hash), matching how
    the capture scripts source these files. None of the real values contain a
    literal '#', so stripping a trailing comment is safe."""
    out = {}
    for line in text.splitlines():
        s = line.strip()
        if not s or s.startswith("#"):
            continue
        m = re.match(r"^([A-Za-z_][A-Za-z0-9_]*)=(.*)$", s)
        if not m:
            continue
        key, raw = m.group(1), m.group(2)
        raw = raw.strip()
        if raw and raw[0] in "\"'":
            # quoted value: take up to the matching close quote
            q = raw[0]
            end = raw.find(q, 1)
            val = raw[1:end] if end != -1 else raw[1:]
        else:
            val = re.sub(r"\s+#.*$", "", raw).strip()  # strip inline comment
        out[key] = val
    return out


def _shell_quote(value):
    s = str(value)
    if s == "" or re.search(r"[\s\"'$`\\#]", s):
        return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'
    return s


def render_env(camera, defaults, rtsp_base):
    """Return the .env file text for one camera dict."""
    merged = dict(defaults or {})
    merged.update({k: v for k, v in camera.items() if v is not None})

    # assemble RTSP_URL from base + path
    rtsp_path = merged.get("rtsp_path")
    if rtsp_path and "rtsp_url" not in merged:
        base = merged.get("rtsp_base", rtsp_base).rstrip("/")
        merged["rtsp_url"] = base + "/" + str(rtsp_path).lstrip("/")

    env = {}
    for field, key in FIELD_TO_ENV:
        if field not in merged or merged[field] is None:
            continue
        val = merged[field]
        if key in BOOL_ENVS:
            val = 1 if val in (True, 1, "1", "true", "yes") else 0
        env[key] = val

    vcam = merged.get("virtual_cam")
    if isinstance(vcam, dict):
        if vcam.get("loopback"):
            env["LOOPBACK"] = vcam["loopback"]
        if vcam.get("width"):
            env["CONF_WIDTH"] = vcam["width"]
        if vcam.get("height"):
            env["CONF_HEIGHT"] = vcam["height"]

    name = camera.get("name", "camera")
    service = camera.get("service", f"{name}-capture")
    lines = [
        f"# {name} capture tunables — GENERATED by porchcam-config from "
        "porchcam.yaml.",
        f"# Edit porchcam.yaml and re-run `porchcam-config render`, then: "
        f"sudo systemctl restart {service}",
    ]
    for key, val in env.items():
        lines.append(f"{key}={_shell_quote(val)}")
    return "\n".join(lines) + "\n"


# --- import (env -> yaml) ----------------------------------------------------

def env_to_camera(filename, env):
    cam = {}
    cam["name"] = None  # filled from rtsp path below, or filename
    cam["service"] = SERVICE_BY_ENV.get(filename, filename.replace(".env", "-capture"))
    cam["env_file"] = filename

    for key, val in env.items():
        if key == "RTSP_URL":
            m = re.match(r"^(rtsp://[^/]+)(/.*)$", val)
            if m:
                if m.group(1) != DEFAULT_RTSP_BASE:
                    cam["rtsp_base"] = m.group(1)
                cam["rtsp_path"] = m.group(2)
                cam["name"] = m.group(2).lstrip("/")
            else:
                cam["rtsp_url"] = val
        elif key in ("LOOPBACK", "CONF_WIDTH", "CONF_HEIGHT"):
            vc = cam.setdefault("virtual_cam", {})
            if key == "LOOPBACK":
                vc["loopback"] = val
            elif key == "CONF_WIDTH":
                vc["width"] = int(val)
            else:
                vc["height"] = int(val)
        elif key in ENV_TO_FIELD:
            field = ENV_TO_FIELD[key]
            if key in INT_ENVS:
                val = int(val)
            elif key in BOOL_ENVS:
                val = val in ("1", "true", "yes", 1, True)
            cam[field] = val
        # unknown keys are preserved verbatim under 'extra_env'
        else:
            cam.setdefault("extra_env", {})[key] = val

    if not cam["name"]:
        cam["name"] = filename.replace(".env", "")
    # order: name/service/env_file first
    ordered = {k: cam[k] for k in ("name", "service", "env_file") if k in cam}
    ordered.update({k: v for k, v in cam.items()
                    if k not in ("name", "service", "env_file")})
    return ordered


def do_import(env_dir, out):
    env_dir = Path(env_dir)
    cams = []
    for env_file in sorted(env_dir.glob("*.env")):
        env = parse_env(env_file.read_text())
        if "DEVICE" not in env and "RTSP_URL" not in env:
            continue  # not a camera env file
        cams.append(env_to_camera(env_file.name, env))
    config = {"version": SCHEMA_VERSION, "rtsp_base": DEFAULT_RTSP_BASE,
              "cameras": cams}
    text = yaml.safe_dump(config, sort_keys=False, default_flow_style=False,
                          width=100)
    if out in ("-", None):
        sys.stdout.write(text)
    else:
        Path(out).write_text(text)
        print(f"porchcam-config: wrote {out} ({len(cams)} camera(s))",
              file=sys.stderr)
    return 0


# --- render (yaml -> env) ----------------------------------------------------

def load_config(path):
    config = yaml.safe_load(Path(path).read_text()) or {}
    if config.get("version") != SCHEMA_VERSION:
        print(f"porchcam-config: warning: config version "
              f"{config.get('version')} != expected {SCHEMA_VERSION}",
              file=sys.stderr)
    return config


def do_render(config_path, out_dir, dry_run):
    config = load_config(config_path)
    defaults = config.get("defaults", {})
    rtsp_base = config.get("rtsp_base", DEFAULT_RTSP_BASE)
    out_dir = Path(out_dir)
    rc = 0
    for cam in config.get("cameras", []):
        env_file = cam.get("env_file") or f"{cam.get('name','camera')}.env"
        # merge any preserved unknown env
        merged = dict(cam)
        text = render_env(merged, defaults, rtsp_base)
        # tack on preserved extra_env lines
        for key, val in (cam.get("extra_env") or {}).items():
            text += f"{key}={_shell_quote(val)}\n"
        target = out_dir / env_file
        if dry_run:
            print(f"# ===== {target} =====")
            sys.stdout.write(text)
        else:
            target.write_text(text)
            print(f"porchcam-config: wrote {target}", file=sys.stderr)
    return rc


def do_validate(config_path):
    try:
        config = load_config(config_path)
    except Exception as exc:
        print(f"porchcam-config: INVALID: {exc}", file=sys.stderr)
        return 1
    cams = config.get("cameras", [])
    if not cams:
        print("porchcam-config: INVALID: no cameras defined", file=sys.stderr)
        return 1
    seen = set()
    ok = True
    for cam in cams:
        name = cam.get("name", "?")
        if name in seen:
            print(f"porchcam-config: INVALID: duplicate camera '{name}'",
                  file=sys.stderr); ok = False
        seen.add(name)
        if not (cam.get("device") or cam.get("source")):
            print(f"porchcam-config: INVALID: camera '{name}' has no device",
                  file=sys.stderr); ok = False
        if not (cam.get("rtsp_path") or cam.get("rtsp_url")):
            print(f"porchcam-config: INVALID: camera '{name}' has no rtsp path",
                  file=sys.stderr); ok = False
    print("porchcam-config: OK" if ok else "porchcam-config: INVALID",
          file=sys.stderr)
    return 0 if ok else 1


def do_list(config_path):
    config = load_config(config_path)
    for cam in config.get("cameras", []):
        vcam = " +virtual-cam" if cam.get("virtual_cam") else ""
        print(f"{cam.get('name','?'):10} {cam.get('width','?')}x"
              f"{cam.get('height','?')}@{cam.get('fps','?')}  "
              f"{config.get('rtsp_base', DEFAULT_RTSP_BASE)}"
              f"{cam.get('rtsp_path','')}{vcam}")
    return 0


def main(argv=None):
    p = argparse.ArgumentParser(prog="porchcam-config", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    pi = sub.add_parser("import", help="build porchcam.yaml from existing *.env")
    pi.add_argument("--env-dir", default=str(DEFAULT_ENV_DIR))
    pi.add_argument("--out", default="-")

    pr = sub.add_parser("render", help="write *.env from porchcam.yaml")
    pr.add_argument("--config", default=str(DEFAULT_CONFIG))
    pr.add_argument("--out-dir", default=str(DEFAULT_ENV_DIR))
    pr.add_argument("--dry-run", action="store_true")

    pv = sub.add_parser("validate", help="check porchcam.yaml")
    pv.add_argument("--config", default=str(DEFAULT_CONFIG))

    pl = sub.add_parser("list", help="list cameras in porchcam.yaml")
    pl.add_argument("--config", default=str(DEFAULT_CONFIG))

    args = p.parse_args(argv)
    if args.cmd == "import":
        return do_import(args.env_dir, args.out)
    if args.cmd == "render":
        return do_render(args.config, args.out_dir, args.dry_run)
    if args.cmd == "validate":
        return do_validate(args.config)
    if args.cmd == "list":
        return do_list(args.config)
    return 2


if __name__ == "__main__":
    sys.exit(main())
