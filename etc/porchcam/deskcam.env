# deskcam capture tunables.  Apply with: sudo systemctl restart deskcam-capture
DEVICE=/dev/v4l/by-id/usb-HDA_Webcam_USB_HDA_Webcam_USB_HDA_Webcam_USB-video-index0
EXPECT_CARD="HDA Webcam USB"
WIDTH=1920
HEIGHT=1080
FPS=20
INPUT_FORMAT=mjpeg
RTSP_URL=rtsp://127.0.0.1:8554/desk
# Virtual camera shown to Zoom/Meet/Teams.
LOOPBACK=/dev/video10
CONF_WIDTH=1280
CONF_HEIGHT=720
# Blue Iris stream bitrate (hardware encoded on the Radeon).
BITRATE=4M
VAAPI_DEVICE=/dev/dri/renderD128
PKT_SIZE=1200
IMG_CTRLS=brightness=8,gamma=130,contrast=36,saturation=64
USB_ID=0c45:6366   # Microdia Vitade (desk) — used to find the cam in any USB port
