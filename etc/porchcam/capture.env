# porchcam capture tunables.  Apply with: sudo systemctl restart porchcam-capture
DEVICE=/dev/v4l/by-id/usb-046d_HD_Pro_Webcam_C920_XXXXXXXX-video-index0
EXPECT_CARD=C920
WIDTH=1920
HEIGHT=1080
FPS=30
INPUT_FORMAT=mjpeg
RTSP_URL=rtsp://127.0.0.1:8554/porch
PKT_SIZE=1200
# 0 = steady frame rate (recommended for Blue Iris motion detection)
# 1 = brighter at night, but frame rate falls as low as ~4fps in darkness
DYNAMIC_FRAMERATE=1
# porch C920 image tuning (no gamma control on this model)
IMG_CTRLS=brightness=176,backlight_compensation=1
BITRATE=6M
VAAPI_DEVICE=/dev/dri/renderD128
USB_ID=046d:082d   # Logitech C920 (porch) — used to find the cam in any USB port
