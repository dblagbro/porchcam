###############################################
# MediaMTX config for porchcam (C920 -> RTSP)
# Managed file. Stock upstream config kept at
# /opt/mediamtx/mediamtx.yml.dist
###############################################

logLevel: info
logDestinations: [stdout]

# --- API (localhost only) : used for readiness checks ---
api: true
apiAddress: 127.0.0.1:9997

# --- RTSP : the only streaming protocol we expose ---
rtsp: true
rtspTransports: [tcp, udp]
rtspAddress: :8554

# --- everything else off: smaller attack surface ---
rtmp: false
hls: false
webrtc: false
srt: false
moq: false

# --- Access control (LAN only; no internet exposure) ---
authMethod: internal
authInternalUsers:
  # Local publisher + local overlay playback, loopback only, no password.
  - user: any
    pass:
    ips: ["127.0.0.1", "::1"]
    permissions:
      - action: publish
      - action: read
      - action: api
      - action: metrics

  # LAN reader account (used by Blue Iris and any other LAN viewer).
  # Read-only, restricted to the local subnet.
  - user: camreader
    pass: @@RTSP_PASSWORD@@
    ips: ["@@LAN_CIDR@@"]
    permissions:
      - action: read

paths:
  porch:
    source: publisher
  desk:
    source: publisher
  porch-sub:
    # 640x360 substream for Blue Iris live view / motion detection.
    # runOnDemand means this encoder starts only when something actually
    # subscribes, and stops 30s after the last reader leaves — so it costs
    # nothing while unused.
    runOnDemand: ffmpeg -nostdin -hide_banner -loglevel warning -vaapi_device /dev/dri/renderD128 -rtsp_transport tcp -i rtsp://127.0.0.1:8554/porch -vf format=nv12,hwupload,scale_vaapi=w=640:h=360 -c:v h264_vaapi -b:v 600k -g 30 -an -f rtsp -rtsp_transport tcp rtsp://127.0.0.1:8554/porch-sub
    runOnDemandRestart: yes
    runOnDemandStartTimeout: 15s
    runOnDemandCloseAfter: 30s
  desk-sub:
    # 640x360 substream for Blue Iris live view / motion detection.
    # runOnDemand means this encoder starts only when something actually
    # subscribes, and stops 30s after the last reader leaves — so it costs
    # nothing while unused.
    runOnDemand: ffmpeg -nostdin -hide_banner -loglevel warning -vaapi_device /dev/dri/renderD128 -rtsp_transport tcp -i rtsp://127.0.0.1:8554/desk -vf format=nv12,hwupload,scale_vaapi=w=640:h=360 -c:v h264_vaapi -b:v 600k -g 30 -an -f rtsp -rtsp_transport tcp rtsp://127.0.0.1:8554/desk-sub
    runOnDemandRestart: yes
    runOnDemandStartTimeout: 15s
    runOnDemandCloseAfter: 30s
